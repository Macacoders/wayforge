#!/usr/bin/env bash
# qa/install-deps
set -euo pipefail

if command -v pacman >/dev/null 2>&1; then
	echo "==> Installing system dependencies with pacman"

	sudo pacman -Syu --needed \
		shellcheck \
		shfmt \
		bats \
		nodejs \
		npm \
		git \
		base-devel
elif command -v apt-get >/dev/null 2>&1; then
	echo "==> Installing system dependencies with apt-get"

	sudo apt-get update
	sudo apt-get install -y \
		shellcheck \
		shfmt \
		bats \
		nodejs \
		npm \
		git \
		build-essential
else
	echo "Unsupported platform/package manager."
	echo
	echo "This installer supports Arch/CachyOS systems with pacman and Ubuntu/Debian-family systems with apt-get."
	echo "Install the QA dependencies manually or run this script on a supported system."
	exit 1
fi

echo "==> Checking PowerShell"

if ! command -v pwsh >/dev/null 2>&1; then
	echo "PowerShell is not installed."
	echo
	echo "On CachyOS/Arch, install it from the AUR, for example:"
	echo
	echo "  paru -S powershell-bin"
	echo
	echo "or:"
	echo
	echo "  yay -S powershell-bin"
	echo
	echo "On Ubuntu/Debian-family systems, install PowerShell using Microsoft's package repository guidance:"
	echo
	echo "  https://learn.microsoft.com/powershell/scripting/install/install-ubuntu"
	echo
	echo "Then rerun:"
	echo
	echo "  make install-deps"
	exit 1
fi

echo "==> Installing PowerShell QA modules"

run_pwsh_heredoc() {
	local tmp_ps
	local status
	tmp_ps="$(mktemp)"
	cat >"$tmp_ps"
	if pwsh -NoProfile -NonInteractive -File "$tmp_ps"; then
		status=0
	else
		status=$?
	fi
	rm -f "$tmp_ps"
	return "$status"
}

run_pwsh_heredoc <<'POWERSHELL'
$ErrorActionPreference = "Stop"

$modules = @(
  "PSScriptAnalyzer",
  "Pester"
)

foreach ($module in $modules) {
  if (-not (Get-Module -ListAvailable -Name $module)) {
    Write-Host "Installing $($module)..."
    Install-Module -Name $module -Scope CurrentUser -Force -AllowClobber
  } else {
    Write-Host "$($module) already installed."
  }
}
POWERSHELL

echo "==> Verifying installed tools"

command -v shellcheck >/dev/null
command -v shfmt >/dev/null
command -v bats >/dev/null
command -v node >/dev/null
command -v npm >/dev/null
command -v pwsh >/dev/null

run_pwsh_heredoc <<'POWERSHELL'
$ErrorActionPreference = "Stop"
Import-Module PSScriptAnalyzer
Import-Module Pester
Write-Host "PowerShell modules OK."
POWERSHELL

echo "==> QA dependencies installed successfully"
