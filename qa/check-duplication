#!/usr/bin/env bash
# qa/check-duplication
set -euo pipefail

if ! command -v npx >/dev/null 2>&1; then
	echo "npx is not installed; skipping duplication check."
	exit 0
fi

# Shell/PowerShell duplication deprecated — TypeScript is the canonical implementation
npx --yes jscpd \
	--pattern "**/*.ts" \
	--ignore "**/.git/**" \
	--ignore "**/node_modules/**" \
	--ignore "**/base/**" \
	--threshold 8 \
	--min-lines 8 \
	--reporters console

echo "Duplication checks passed."
