#!/usr/bin/env bash
# qa/check-powershell
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/_helpers.sh"

if ! command -v pwsh >/dev/null 2>&1; then
	echo "pwsh is not installed; skipping PowerShell checks."
	exit 0
fi

run_pwsh_heredoc <<'POWERSHELL'
$ErrorActionPreference = "Stop"

$files = Get-ChildItem -Path . -Recurse -Include *.ps1,*.psm1,*.psd1 |
  Where-Object {
    $_.FullName -notmatch "[/\\]\.git[/\\]" -and
    $_.FullName -notmatch "[/\\]\.opencode[/\\]" -and
    $_.FullName -notmatch "[/\\]node_modules[/\\]"
  }

if (-not $files) {
  Write-Host "No PowerShell files found."
  exit 0
}

if (-not (Get-Module -ListAvailable -Name PSScriptAnalyzer)) {
  throw "PSScriptAnalyzer is not installed. Run: Install-Module PSScriptAnalyzer -Scope CurrentUser"
}

$styleRules = @(
  # Style-only rules are too noisy for this repository's internal helpers and
  # interactive installer scripts. Substantive analyzer warnings still fail QA.
  "PSAvoidUsingWriteHost",
  "PSUseApprovedVerbs",
  "PSUseBOMForUnicodeEncodedFile",
  "PSUseSingularNouns"
)

$results = foreach ($file in $files) {
  Invoke-ScriptAnalyzer -Path $file.FullName -Severity Error,Warning -ExcludeRule $styleRules
}

if ($results) {
  $results |
    Sort-Object ScriptPath, Line, RuleName |
    ForEach-Object {
      $shortPath = [System.IO.Path]::GetRelativePath((Resolve-Path '.').Path, $_.ScriptPath)
      $message = $_.Message
      if ($message.Length -gt 160) {
        $message = $message.Substring(0, 157) + '...'
      }
      "[$($_.RuleName)] [$($_.Severity)] ${shortPath}:$($_.Line) $message"
    }
  throw "PSScriptAnalyzer found issues."
}

Write-Host "PowerShell checks passed."
POWERSHELL
