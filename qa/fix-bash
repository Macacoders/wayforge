#!/usr/bin/env bash
# qa/fix-bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/_helpers.sh"

mapfile -d '' files < <(find_bash_files)

if [ "${#files[@]}" -eq 0 ]; then
	echo "No Bash files found."
	exit 0
fi

echo "Formatting Bash files with shfmt..."
shfmt -w "${files[@]}"

echo "Bash formatting complete."
