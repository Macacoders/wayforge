{
  "name": "ai-config-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform CLI installer for ai-config",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-config": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "vitest": {
    "include": ["tests/**/*.test.ts"]
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
