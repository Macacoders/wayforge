<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="wayforge-win32-x64.exe" product-name="wayforge" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="wayforge-win32-arm64.exe" product-name="wayforge" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
    <powershell-file path="install.ps1">
      <authenticode-sign/>
    </powershell-file>
  </zip-file>
</artifact-configuration>
