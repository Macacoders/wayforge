#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
skill_helper="$repo_root/.opencode/skills/shared-task/scripts/gh-issue"

if [[ ! -x "$skill_helper" ]]; then
  printf 'Error: skill helper is missing or not executable: %s\n' "$skill_helper" >&2
  exit 1
fi

exec "$skill_helper" "$@"
