{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "ESNext",
                            "moduleResolution":  "bundler",
                            "allowImportingTsExtensions":  true,
                            "noEmit":  true,
                            "isolatedModules":  true,
                            "esModuleInterop":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "types":  [
                                          "node"
                                      ],
                            "strict":  true,
                            "skipLibCheck":  true
                        },
    "include":  [
                    "base/skills/shared-task/scripts/**/*.ts",
                    "base/skills/ai-memory/scripts/**/*.ts",
                    "scripts/**/*.ts"
                ]
}
