{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "base/opencode/skills/shared-task/scripts/**/*.ts",
    "tests/typescript/**/*.ts"
  ]
}
