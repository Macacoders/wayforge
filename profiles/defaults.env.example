# OpenCode defaults used by local/generated opencode.jsonc
OPENCODE_PROVIDER=openai
OPENCODE_MODEL=openai/gpt-5.5
OPENCODE_SMALL_MODEL=openai/gpt-5.4-mini
OPENCODE_DEFAULT_AGENT=planner

# OpenAI auth note:
# OpenCode should be authenticated via /connect (ChatGPT Plus/Pro or Azure credentials).
# No OPENAI_API_KEY env var is required by this template.

# GitHub Copilot auth note:
# OpenCode should be authenticated via /connect (device login flow).
# No provider-specific env vars are required by this template.

# Laberit provider variables (OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://your-laberit-endpoint.example.com/openai/v1
OPENAI_API_KEY=replace-with-your-laberit-api-key
