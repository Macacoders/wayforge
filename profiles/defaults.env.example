# OpenCode defaults used by local/generated opencode.jsonc
OPENCODE_PROVIDER=openai
OPENCODE_MODEL=openai/gpt-5.5
OPENCODE_SMALL_MODEL=openai/gpt-5.4-mini-fast
OPENCODE_DEFAULT_AGENT=planner

# OpenAI auth note:
# OpenCode should be authenticated via /connect (ChatGPT Plus/Pro or Azure credentials).
# No OPENAI_API_KEY env var is required by this template.

# Kimi25 (Azure-hosted Kimi K2.5) provider variables
KIMI_BASE_URL=https://your-azure-openai-compatible-endpoint.example.com/openai/v1
KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_API_VERSION=2024-10-21
