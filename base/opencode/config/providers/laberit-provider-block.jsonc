    "laberit": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Laberit AI",
      "env": ["OPENAI_API_KEY"],
      "options": {
        "baseURL": "${OPENAI_BASE_URL}",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "models": {
        "laberit-ai-preview": {
          "name": "Laberit AI Preview",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "laberit-ai": {
          "name": "Laberit AI",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "laberit-gpt-5.6-luna": {
          "name": "GPT-5.6-luna",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
