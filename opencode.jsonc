{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openai"],
  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini-fast",
  "default_agent": "planner",
  "share": "disabled",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "medium"
          }
        },
        "gpt-5.5-fast": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "medium"
          }
        }
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
